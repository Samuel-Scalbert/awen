# Config Awen
FLASK_ENV=development
SECRET_KEY=change-me
# Laisser vide/commenté pour utiliser le chemin absolu par défaut (app/config.py).
# Un chemin relatif ici casse le rechargement à chaud de Flask sur Windows.
#DATABASE_URL=sqlite:///data/awen.db

# Calendrier Samsung (URL ICS export)
SAMSUNG_CALENDAR_ICS_URL=

# Clé partagée avec l'ESP32
ESP32_API_KEY=change-me

# Dossier du pipeline Claude cowork de recherche d'emploi
# (contient "Veille quotidienne/<YYYY-MM-DD>/Compte rendu.md")
# PC Windows : C:\Users\<toi>\Claude\Projects\Recherche de CDI
# Serveur    : /srv/recherche-cdi (alimenté par scripts/sync-jobs.ps1)
JOB_SEARCH_DIR=

# Spotify. Le jeton vit ici et pas sur l'ESP32 : sur une carte il serait en
# clair, lisible en branchant un cable, et irrevocable sans reflasher.
# Le refresh token doit avoir les portees user-read-playback-state ET
# user-modify-playback-state, sinon les commandes repondent 403.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Meteo (Open-Meteo, sans cle). Le quartier suffit : quelques kilometres
# d'ecart changent a peine les chiffres. Vide : le centre de Paris.
WEATHER_LAT=
WEATHER_LON=

# Jarvis. Depuis le conteneur, l'hote se joint par host.docker.internal
# (voir l'extra_hosts du docker-compose). En developpement sur le PC,
# mettre http://127.0.0.1:11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Duree pendant laquelle le modele reste charge en VRAM entre deux
# questions. "0" le decharge aussitot, au prix d'un rechargement.
OLLAMA_KEEP_ALIVE=30m
# Voix Piper (.onnx). Vide : le navigateur parle a sa place.
PIPER_MODEL=

# Lettres de motivation (page Jobs > Lettres). Cle a creer sur
# https://platform.claude.com (la Claude Console) : l'usage de l'API est facture a part de
# l'abonnement Claude, 10 a 20 centimes par lettre.
ANTHROPIC_API_KEY=
# Modele et effort. Plus d'effort : lettre plus soignee, plus lente, plus chere.
LETTRE_MODEL=claude-opus-5-5
LETTRE_EFFORT=high
# Ou sans frais en plus, avec l'abonnement Claude : jeton cree sur le PC par
# `claude setup-token`. S'il est la, il passe avant la cle d'API.
CLAUDE_CODE_OAUTH_TOKEN=
# auto (par defaut), abonnement ou api. Modele de l'abonnement : opus, sonnet.
# LETTRE_MOTEUR=auto
# LETTRE_MODEL_ABONNEMENT=
# Reflexion plafonnee (low, medium, high) : c'est elle qui consomme le plus.
# LETTRE_EFFORT_ABONNEMENT=medium

# Rappel du soir quand une seance commencee dans la journee n'est pas
# terminee (heure locale, HH:MM).
RAPPEL_SEANCE_HEURE=20:00
# Le serveur ecrit ce rappel dans un agenda Google "Awen" (voir le README,
# "Rappel de seance dans Google Agenda"). Identifiant de l'agenda, et cle du
# compte de service posee dans data/google-agenda.json (ignore par git).
GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/google-agenda.json
